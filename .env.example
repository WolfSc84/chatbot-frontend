# Chatbot Web Interface Simulator — environment template
#
# Copy to `.env.local` for local overrides (git-ignored). Do NOT put secrets
# here. The backend bearer token is read server-side from the repo-root
# `platform-AI-Support/.env` (PLATFORM_BEARER_TOKEN) and is never exposed to
# the browser or committed.

# Base URL of the Chatbot V2 backend agent API (recommended: versioned /api/v1).
BACKEND_API_BASE=http://localhost:5600/api/v1/agent

# Fallback tenant used when a request carries no (or an invalid) x-product
# header. Must be one of: sales | knowledge_center. Fail-closed safe default.
NEXT_PUBLIC_DEFAULT_TENANT=sales

# L1 support-team tool mode [L1-variation]. Mirrors the backend L1_SUPPORT_MODE.
# false (default) = standard simulator (server-injected bearer token, live-data
# features shown). true = L1 tool: an operator identity gate (name + Platform
# email) is required on open, the support identity is sent to the proxy, and
# live-data feature entry points are hidden (troubleshooting + ticketing stay).
# Keep in sync with the backend flag for the deployment.
NEXT_PUBLIC_L1_SUPPORT_MODE=false
